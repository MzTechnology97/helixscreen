<!-- K2-OpenHost: the runout swap page, opened from the CFS page. The switch,
     automatic or manual sequence, and for each group of identical spools the
     order in which they are used. K2ohRunoutView fills the groups. -->
<component>
  <view extends="lv_obj"
        width="100%" height="100%" style_pad_all="#space_sm" style_pad_gap="#space_sm" style_bg_color="#screen_bg"
        style_bg_opa="255" style_border_width="0" style_radius="0" flex_flow="column" scrollable="false">
    <lv_obj width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0"
            style_border_width="0" flex_flow="row" style_flex_cross_place="center" scrollable="false">
      <lv_obj name="runout_back"
              width="content" height="#button_height_sm" style_pad_all="0" style_pad_right="#space_sm"
              style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0" flex_flow="row"
              style_flex_cross_place="center" scrollable="false" clickable="true">
        <icon src="back" size="lg" variant="text" clickable="false" event_bubble="true"/>
        <text_heading text="Auto-swap at spool end" translation_tag="Auto-swap at spool end" clickable="false"
                      event_bubble="true"/>
      </lv_obj>
      <lv_obj width="1" height="1" flex_grow="1" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false"/>
      <ui_switch name="swap_switch" size="small"/>
    </lv_obj>

    <text_small text="When a spool runs out, the print goes on with an identical one (same material and colour)."
                translation_tag="When a spool runs out, the print goes on with an identical one (same material and colour)."
                width="100%" style_text_color="#text_muted"/>

    <lv_obj width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0"
            style_border_width="0" flex_flow="row" scrollable="false">
      <ui_button name="btn_mode_auto" flex_grow="1" height="#button_height" variant="secondary" icon="sync"
                 text="Automatic" translation_tag="Automatic"/>
      <ui_button name="btn_mode_manual" flex_grow="1" height="#button_height" variant="secondary"
                 icon="swap_vertical" text="Manual" translation_tag="Manual"/>
    </lv_obj>
    <text_small name="mode_hint" text="" width="100%" style_text_color="#text_muted"/>

    <lv_obj name="groups_list"
            width="100%" flex_grow="1" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0"
            style_border_width="0" flex_flow="column" scrollable="true" scroll_dir="ver"/>

    <ui_button name="btn_save_order" width="100%" height="#button_height" variant="primary" icon="check"
               text="Save order" translation_tag="Save order" hidden="true"/>
  </view>
</component>
