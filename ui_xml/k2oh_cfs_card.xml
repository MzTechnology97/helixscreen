<!-- K2-OpenHost: one CFS spool. K2ohCfsView fills it: the ring (an lv_arc it
     adds to ring_box) is the share left, the core is the filament colour. -->
<component>
  <view extends="lv_obj"
        width="48%" height="48%" style_radius="#border_radius" style_bg_color="#card_bg" style_bg_opa="255"
        style_border_width="2" style_border_color="#card_bg" style_pad_all="#space_sm" style_pad_gap="#space_sm"
        flex_flow="row" style_flex_cross_place="center" scrollable="false" clickable="true">
    <lv_obj name="in_use_tag"
            width="content" height="content" align="top_right" floating="true" style_bg_color="#primary"
            style_bg_opa="255" style_radius="8" style_pad_left="#space_xs" style_pad_right="#space_xs" style_pad_top="1"
            style_pad_bottom="1" style_border_width="0" scrollable="false" clickable="false" event_bubble="true"
            hidden="true">
      <text_xs name="in_use_label" text="IN USE" style_text_color="#text" clickable="false" event_bubble="true"/>
    </lv_obj>
    <lv_obj name="ring_box"
            width="70" height="70" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
            clickable="false" event_bubble="true">
      <lv_obj name="core"
              width="54" height="54" align="center" style_radius="27" style_bg_opa="255" style_border_width="3"
              style_border_color="#card_bg" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
        <lv_obj name="hole"
                width="14" height="14" align="center" style_radius="7" style_bg_color="#card_bg" style_bg_opa="255"
                style_border_width="0" scrollable="false" clickable="false" event_bubble="true"/>
        <icon name="unknown_icon" src="help" size="sm" variant="secondary" align="center" hidden="true"
              clickable="false" event_bubble="true"/>
      </lv_obj>
      <lv_obj name="num_badge"
              width="22" height="22" align="top_left" style_radius="11" style_bg_color="#elevated_bg" style_bg_opa="255"
              style_border_width="0" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
        <text_small name="num_label" text="" align="center" style_text_color="#text" clickable="false"
                    event_bubble="true"/>
      </lv_obj>
    </lv_obj>
    <lv_obj height="content" flex_grow="1" style_pad_all="0" style_pad_gap="0" style_bg_opa="0"
            style_border_width="0" flex_flow="column" scrollable="false" clickable="false" event_bubble="true">
      <text_body name="material_label" text="" long_mode="dots" width="100%" clickable="false" event_bubble="true"/>
      <text_muted name="brand_label" text="" long_mode="dots" width="100%" clickable="false" event_bubble="true"/>
      <text_small name="amount_label" text="" long_mode="dots" width="100%" clickable="false" event_bubble="true"/>
      <lv_obj name="source_chip"
              width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="8"
              style_pad_left="#space_xs" style_pad_right="#space_xs" style_pad_top="1" style_pad_bottom="1"
              style_margin_top="2" style_border_width="0" scrollable="false" clickable="false" event_bubble="true"
              hidden="true">
        <text_xs name="source_label" text="" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
